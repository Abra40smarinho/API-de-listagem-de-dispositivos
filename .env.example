# URL do WebSocket do Home Assistant
# Mesmo host/rede: ws://IP_DO_HA:8123/api/websocket
# Com HTTPS:       wss://ha.exemplo.com/api/websocket
HA_URL=ws://homeassistant:8123/api/websocket

# Long-Lived Access Token (Perfil -> Segurança -> Tokens de acesso de longa duração)
HA_TOKEN=cole_o_token_aqui

# (opcional) Chave para proteger a sua API, se você adicionar autenticação
# API_KEY=gere_uma_chave_longa_e_aleatoria
